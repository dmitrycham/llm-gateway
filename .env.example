# Local settings for compose.yaml. Copy and change the passwords:
#   cp .env.example .env
# .env is git-ignored. Only Compose reads it; the services never read a dotenv file.

# --- Host ports (bound to 127.0.0.1 only) ---
GO_API_HOST_PORT=8090
POSTGRES_HOST_PORT=5432

# --- PostgreSQL ---
POSTGRES_DB=llm_gateway
# Superuser: the init script and manual admin work only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Roles of spec §8.4. They are created on the first start of an empty volume, so a
# later change needs ALTER ROLE, or `docker compose down -v`, which deletes all data.
MIGRATOR_PASSWORD=change-me-migrator
APP_SERVICE_PASSWORD=change-me-app-service
AI_SERVICE_PASSWORD=change-me-ai-service
AI_WORKER_PASSWORD=change-me-ai-worker
GATEWAY_SERVICE_PASSWORD=change-me-gateway-service

# --- go-api (services/go-api/README.md) ---
GO_API_LOG_LEVEL=info
GO_API_SHUTDOWN_TIMEOUT=15s
